# Inkarr Environment Configuration

# Database URL (SQLite)
DATABASE_URL="file:./data/inkarr.db"

# Debug logging (set to "true" to enable verbose logging)
DEBUG_LOGGING="false"

# Metadata Provider API Keys
COMICVINE_API_KEY="your_comicvine_api_key"

# Optional: AniList OAuth (if implementing OAuth flow)
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# Application Settings
INKARR_DATA="./data"
NODE_ENV="development"

# Security: Set to "true" if using HTTPS, "false" for HTTP-only deployments
# When true, auth cookies require HTTPS. Set to false for local network without TLS.
SECURE_COOKIES="false"
